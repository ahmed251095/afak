<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "nesma" invoice: a variant of invoice_customer_report_new that was kept as a
         database copy (view 946, `..._new_copy_1`) until it broke on 19.0 because of
         the removed l10n_sa_delivery_date field. Moved here so it is versioned with
         the module and fixed by module updates. It reuses the module's own header /
         footer layout instead of the copy that was made of it. -->
    <template id="invoice_customer_report_nesma">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang='en_US')"/>
                <!-- Overridable by a report that reuses this template (see the real
                     estate one); the defaults are the investment company's account. -->
                <t t-set="bank_name_en" t-value="bank_name_en or 'Bank Aljazira'"/>
                <t t-set="bank_name_ar" t-value="bank_name_ar or 'بنك الجزيرة'"/>
                <t t-set="bank_swift" t-value="bank_swift or 'BJAZSAJE'"/>
                <t t-set="bank_iban" t-value="bank_iban or 'SA9560100030995010772001'"/>
                <t t-set="bank_account_name_en" t-value="bank_account_name_en or 'Nsma Horizons Investment Company'"/>
                <t t-set="bank_account_name_ar" t-value="bank_account_name_ar or 'شركة افاق نسما للاستثمار'"/>
                <t t-set="bank_account_number" t-value="bank_account_number or '030995010772001'"/>
                <!-- The QR / title / logo are printed inline at the top of the body
                     instead of through a class="header" block: wkhtmltopdf reserves a
                     fixed band for a running header whose height does not follow its
                     content, which left a wide empty strip (and overlapped the first
                     rows once the top margin was reduced). Inline, the body simply
                     starts right under them. Trade-off: they no longer repeat on the
                     following pages. -->
                <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                    <div class="page" style="font-family:arial" dir="rtl">
                        <div class="oe_structure"/>
                        <div class="row" dir="ltr">
                            <div class="col-4">
                                <img t-if="o.l10n_sa_qr_code_str" style="display:block;"
                                     t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(o.l10n_sa_qr_code_str), 150, 150)"/>
                            </div>
                            <div class="col-4 text-center" style="font-family:arial;padding-top:25px">
                                <span style="font-size:20px;font-weight:bold">فاتورة ضريبية</span>
                                <br/>
                                <span style="font-size:20px;font-weight:bold">Tax Invoice</span>
                            </div>
                            <div class="col-4 text-end">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                                     style="height:110px;width:165px;"/>
                            </div>
                        </div>
                        <div id="informations">
                            <div class="row">
                                <div class="col-2 offset-0">
                                    <strong style="white-space:nowrap;font-size:12px">رقم الفاتوره</strong>
                                </div>
                                <div class="col-7 text-center">
                                    <span style=";font-size:12px" t-field="o.name"/>
                                </div>
                                <div class="col-3 text-end">
                                    <strong style="white-space:nowrap;font-size:12px">Invoice No</strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0">
                                    <strong style="white-space:nowrap;font-size:12px">تاريخ إصدار الفاتورة</strong>
                                </div>
                                <div class="col-7 text-center">
                                    <span style=";font-size:12px" t-field="o.invoice_date"/>
                                </div>
                                <div class="col-3 text-end">
                                    <strong style="white-space:nowrap;font-size:12px">Invoice Issue Date</strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0">
                                    <strong style="white-space:nowrap;font-size:12px">تاريخ التوريد</strong>
                                </div>
                                <div class="col-7 text-center">
                                    <span style=";font-size:12px" t-field="o.delivery_date"/>
                                </div>
                                <div class="col-3 text-end">
                                    <strong style="white-space:nowrap;font-size:12px">Date of Supply</strong>
                                </div>
                            </div>
                        </div>
                        <div class="row " style="font-weight:bold;font-size:16px;color:white;background-color:#38b0d2">
                            <div class="col-12 text-center">
                                <span>Supplier Details / بيانات المورد</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-1 offset-0">
                                <strong style="white-space:nowrap;font-size:12px">الاسم.</strong>
                            </div>
                            <div class="col-3 text-center">
                                <span style=";font-size:12px" t-field="o.company_id.name"/>
                            </div>
                            <div class="col-1 text-end">
                                <strong style="white-space:nowrap;font-size:12px">Name</strong>
                            </div>
                            <div class="col-1"/>
                            <div class="col-2 offset-0"><strong style="white-space:nowrap;font-size:12px">رقم السجل التجارى</strong></div>
                            <div class="col-2 text-center"><span style=";font-size:12px" t-field="o.company_id.company_registry"/></div>
                            <div class="col-2 text-end"> <strong style="white-space:nowrap;font-size:12px">CR Number</strong></div>
                        </div>
                        <div class="row">
                            <div class="col-2 offset-0"><strong style="white-space:nowrap;font-size:12px">الرقم الضريبي</strong></div>
                            <div class="col-2 text-center"><span style=";font-size:12px" t-field="o.company_id.vat"/></div>
                            <div class="col-1 text-end"> <strong style="white-space:nowrap;font-size:12px">Vat No </strong></div>
                            <div class="col-1"/>
                            <div class="col-1 offset-0"><strong style="white-space:nowrap;font-size:12px">الدولة</strong></div>
                            <div class="col-4 text-center"><span style=";font-size:12px" t-field="o.company_id.country_id"/></div>
                            <div class="col-1 text-end"> <strong style="white-space:nowrap;font-size:12px">Country</strong></div>
                        </div>
                        <div class="row">
                            <div class="col-1 offset-0"><strong style="white-space:nowrap;font-size:12px">العنوان</strong></div>
                            <div class="col-9 text-center"><span style=";font-size:12px" t-field="o.company_id.street"/></div>
                            <div class="col-1 text-end"> <strong style="white-space:nowrap;font-size:12px">Adress</strong></div>
                            <div class="col-1"/>
                        </div>
                        <div class="row " style="font-weight:bold;font-size:16px;color:white;background-color:#38b0d2">
                            <div class="col-12 text-center">
                                <span>Client Details / بيانات العميل</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-1 offset-0"><strong style="white-space:nowrap;font-size:12px">الاسم</strong></div>
                            <div class="col-3 text-center"><span style=";font-size:12px" t-field="o.partner_id.name"/></div>
                            <div class="col-1 text-end"> <strong style="white-space:nowrap;font-size:12px">Name</strong></div>
                            <div class="col-1"/>
                            <div class="col-2 offset-0"><strong style="white-space:nowrap;font-size:12px">رقم السجل التجارى</strong></div>
                            <div class="col-2 text-center"><span style=";font-size:12px" t-field="o.partner_id.x_studio_cr_number"/></div>
                            <div class="col-2 text-end"> <strong style="white-space:nowrap;font-size:12px">CR Number </strong></div>
                        </div>
                        <div class="row">
                            <div class="col-2 offset-0"><strong style="white-space:nowrap;font-size:12px">الرقم الضريبي</strong></div>
                            <div class="col-2 text-center"><span style=";font-size:12px" t-field="o.partner_id.vat"/></div>
                            <div class="col-1 text-end"> <strong style="white-space:nowrap;font-size:12px">Vat No </strong></div>
                            <div class="col-1"/>
                            <div class="col-2 offset-0"><strong style="white-space:nowrap;font-size:12px">مجموعه الرقم الضريبي</strong></div>
                            <div class="col-2 text-center"><span style=";font-size:12px" t-field="o.partner_id.x_studio_vat_group_no_1"/></div>
                            <div class="col-2 text-end"> <strong style="white-space:nowrap;font-size:12px">Vat Group No </strong></div>
                        </div>
                        <div class="row">
                            <div class="col-1 offset-0"><strong style="white-space:nowrap;font-size:12px">العنوان</strong></div>
                            <div class="col-9 text-center"><span style=";font-size:12px" t-field="o.partner_id.street"/>,<span t-field="o.partner_id.city"/></div>
                            <div class="col-1 text-end"> <strong style="white-space:nowrap;font-size:12px">Address</strong></div>
                            <div class="col-1"/>
                        </div>
                    </div>
                    <style>
                        .dashed-line {
                            border: 1px dashed black;
                        }
                    </style>
                    <div class="row ">
                        <table width="100%" border="0" dir="rtl">
                            <thead style="font-weight:bold;font-size:12px;color:white;background-color:#38b0d2">
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Description</span>
                                    <br/>
                                    <span>الوصف</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Unit Price</span>
                                    <br/>
                                    <span>سعر الوحده</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Quantity</span>
                                    <br/>
                                    <span>الكمية/الفترة</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Discount</span>
                                    <br/>
                                    <span>خصومات</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Taxable Amount</span>
                                    <br/>
                                    <span>المبلغ الخاضع للضريبة</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Tax Rate</span>
                                    <br/>
                                    <span>نسبة الضريبة</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Tax Amount</span>
                                    <br/>
                                    <span>مبلغ الضريبة</span>
                                </th>
                                <th class="text-center" style="vertical-align:middle">
                                    <span>Total Including VAT</span>
                                    <br/>
                                    <span>المجموع شامل ضريبة</span>
                                    <br/>
                                    <span>القيمه المضافة</span>
                                </th>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"><span t-field="line.name"/> </td>
                                        <td class="text-center"><span t-field="line.price_unit"/> </td>
                                        <td class="text-center"><span t-field="line.quantity"/> </td>
                                        <td class="text-center"><span t-esc="round(line.quantity*line.price_unit*line.discount/100,2)"/> </td>
                                        <td class="text-center"><span t-esc="round(line.price_subtotal,2)"/> </td>
                                        <td class="text-center">
                                            <span t-if="line.tax_ids" t-esc="line.tax_ids[0].amount"/>%
                                        </td>
                                        <td class="text-center"><span t-esc="round(line.price_total-line.price_subtotal,2)"/> </td>
                                        <td class="text-center"><span t-esc="round(line.price_total,2)"/> </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td colspan="8">
                                        <div class="dashed-line"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td/>
                                    <td class="text-center"><span>Total</span></td>
                                    <td><span/></td>
                                    <td><span/></td>
                                    <td class="text-center"><span t-esc="o.amount_untaxed"/><span t-esc="o.currency_id.name"/></td>
                                    <td><span/></td>
                                    <td class="text-center"><span t-esc="o.amount_tax"/><span t-esc="o.currency_id.name"/></td>
                                    <td class="text-center"><span t-esc="o.amount_total"/><span t-esc="o.currency_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-1 offset-0">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-2 text-end">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-6 text-center">
                            <strong style="font-weight:bold;white-space:nowrap">Local Currency</strong>
                        </div>
                        <div class="col-3 text-end"> <strong style="white-space:nowrap"/></div>
                    </div>
                    <t t-set="discount" t-value="0"/>
                    <t t-foreach="o.invoice_line_ids" t-as="line">
                        <t t-set="discount" t-value="line.quantity*line.price_unit*line.discount/100"/>
                    </t>
                    <div class="row" style="padding-bottom:5px">
                        <div class="col-1 offset-0">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-2 offset-0">
                            <strong style="white-space:nowrap;font-size:12px">Total Excluding VAT.</strong>
                        </div>
                        <div class="col-6 text-center">
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-6" style="border: 1px dashed black;">
                                    <div class="row">
                                        <div class="col-6 offset-0">
                                            <span>ريال سعودي</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-esc="o.amount_untaxed+discount"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3"/>
                            </div>
                        </div>
                        <div class="col-3 text-end" style="font-size:12px"> <strong style="white-space:nowrap">:الإجمالي غير شامل الضريبة</strong></div>
                    </div>
                    <div class="row" style="padding-bottom:5px">
                        <div class="col-1 offset-0">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-2 offset-0">
                            <strong style="white-space:nowrap;font-size:12px">Discount.</strong>
                        </div>
                        <div class="col-6 text-center">
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-6" style="border: 1px dashed black;">
                                    <div class="row">
                                        <div class="col-6 offset-0">
                                            <span>ريال سعودي</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-esc="round(discount,2)"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3"/>
                            </div>
                        </div>
                        <div class="col-3 text-end" style=" font-size:12px"> <strong style="white-space:nowrap">:مجموع الخصومات</strong></div>
                    </div>
                    <div class="row">
                        <div class="col-1 offset-0">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-2 offset-0">
                            <strong style="white-space:nowrap;font-size:12px">Total Taxable Amount <br/>(Excluding VAT).</strong>
                        </div>
                        <div class="col-6 text-center">
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-6" style="border: 1px dashed black;">
                                    <div class="row">
                                        <div class="col-6 offset-0">
                                            <span>ريال سعودي</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <t t-set="discount" t-value="0"/>
                                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                                <t t-set="discount" t-value="line.quantity*line.price_unit*line.discount/100"/>
                                            </t>
                                            <span t-esc="o.amount_untaxed"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3"/>
                            </div>
                        </div>
                        <div class="col-3 text-end" style=" font-size:12px"> <strong style="white-space:nowrap">:إجمالي المبلغ بعد الخصومات <br/> غير شامل ض.ق.م</strong></div>
                    </div>
                    <div class="row" style="padding-bottom:5px">
                        <div class="col-1 offset-0">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-2 offset-0">
                            <strong style="white-space:nowrap;font-size:12px">Total VAT </strong> <span t-esc="', '.join(map(lambda x: (str(x.amount)), o.invoice_line_ids.mapped('tax_ids')))"/><span>%</span>
                        </div>
                        <div class="col-6 text-center">
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-6" style="border: 1px dashed black;">
                                    <div class="row">
                                        <div class="col-6 offset-0">
                                            <span>ريال سعودي</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-esc="o.amount_tax"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3"/>
                            </div>
                        </div>
                        <div class="col-3 text-end" style=" font-size:12px"> <strong style="white-space:nowrap"><span t-esc="', '.join(map(lambda x: (str(x.amount)), o.invoice_line_ids.mapped('tax_ids')))"/><span>%</span> مجموع ض.ق.م</strong></div>
                    </div>
                    <div class="row" style="padding-bottom:5px">
                        <div class="col-1 offset-0">
                            <strong style="white-space:nowrap"/>
                        </div>
                        <div class="col-2 offset-0">
                            <strong style="white-space:nowrap;font-size:12px">Total Amount Due. </strong>
                        </div>
                        <div class="col-6 text-center">
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-6" style="border: 1px dashed black;">
                                    <div class="row">
                                        <div class="col-6 offset-0">
                                            <span>ريال سعودي</span>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-esc="o.amount_total"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-3"/>
                            </div>
                        </div>
                        <div class="col-3 text-end" style=" font-size:12px"> <strong style="white-space:nowrap"> :إجمالي المبلغ المستحق</strong></div>
                    </div>
                    <br/>
                    <br/>
                    <div class="row">
                        <div class="col-12" style="border:2px solid black">
                            <div class="row">
                                <div class="col-3"/>
                                <div class="col-3 offset-0" style="margin-top:5px;"><strong style="white-space:nowrap;font-weight:bold">Bank Details</strong></div>
                                <div class="col-2 offset-0" style="margin-top:5px;"><strong style="white-space:nowrap;font-weight:bold">تفاصيل البنك</strong><span style="color:white">...</span></div>
                                <div class="col-3"/>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0" style="margin-top:5px;margin-left:5px;"><strong style="white-space:nowrap">Bank Name:</strong><span style="color:white">...</span></div>
                                <div class="col-4 offset-0"><span t-out="bank_name_en"/></div>
                                <div class="col-4 text-end"> <span t-out="bank_name_ar"/> </div>
                                <div class="col-2 text-end" style="margin-top:5px;margin-right:5px;"><strong style="white-space:nowrap">:إسم البنك</strong><span style="color:white">...</span></div>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0" style="margin-top:5px;margin-left:5px;"><strong style="white-space:nowrap">IBAN No:</strong></div>
                                <div class="col-4 offset-0"><span t-out="bank_iban"/></div>
                                <div class="col-4 text-end"><span t-out="bank_iban"/></div>
                                <div class="col-2 text-end" style="margin-top:5px;;margin-right:5px;"><strong style="white-space:nowrap">:رقم الايبان</strong><span style="color:white">...</span></div>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0" style="margin-top:5px;;margin-left:5px;"><strong style="white-space:nowrap">SWIFT:</strong></div>
                                <div class="col-4 offset-0"><span t-out="bank_swift"/></div>
                                <div class="col-4 text-end"><span t-out="bank_swift"/> </div>
                                <div class="col-2 text-end" style="margin-top:5px;margin-right:5px;"><strong style="white-space:nowrap">:سويفت</strong><span style="color:white">...</span></div>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0" style="margin-top:5px;margin-left:5px;"><strong style="white-space:nowrap">Account Name:</strong></div>
                                <div class="col-4 offset-0"><span t-out="bank_account_name_en"/></div>
                                <div class="col-4 text-end"> <span t-out="bank_account_name_ar"/> </div>
                                <div class="col-2 text-end" style="margin-top:5px;margin-right:5px;"><strong style="white-space:nowrap">:إسم الحساب</strong><span style="color:white">...</span></div>
                            </div>
                            <div class="row">
                                <div class="col-2 offset-0" style="margin-top:5px;margin-left:5px;"><strong style="white-space:nowrap">Account Number:</strong></div>
                                <div class="col-4 offset-0"><span t-out="bank_account_number"/></div>
                                <div class="col-4 text-end"><span t-out="bank_account_number"/></div>
                                <div class="col-2 text-end" style="margin-top:5px;margin-right:5px;"><strong style="white-space:nowrap">:رقم الحساب</strong><span style="color:white">...</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="footer">
                    <div class="text-center text-muted" t-if="report_type == 'pdf'">
                        Page: <span class="page"/> of <span class="topage"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- No running header on this report, so the top margin is just breathing
         space; the generic A4 format would reserve 40mm + 35mm of header spacing. -->
    <record id="paperformat_nesma" model="report.paperformat">
        <field name="name">Nesma Tax Invoice</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">110</field>
    </record>

    <record id="invoice_report_nesma" model="ir.actions.report">
        <field name="name">nesma</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
